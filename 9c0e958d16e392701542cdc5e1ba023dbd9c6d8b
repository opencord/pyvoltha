      "writtenOn": "2019-10-28T14:32:50Z",
      "side": 1,
      "message": "here is where the \"successes\" as sent to the onu are set in the mib_data_sync.  The purpose of doing this here is this function is an event queue callback and its guarantees the message ordering is correct, so that when we set it here previous or upcoming increments do not get out of alignment.",
      "range": {
        "startLine": 898,
        "startChar": 24,
        "endLine": 898,
        "endChar": 87
      },
      "revId": "9c0e958d16e392701542cdc5e1ba023dbd9c6d8b",
      "serverId": "2a2bfe1b-c5c2-48ed-9ac8-16438ab24388",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "848417b7_fd517677",
        "filename": "pyvoltha/adapters/extensions/omci/tasks/mib_reconcile_task.py",
