      },
      "lineNbr": 155,
      "author": {
        "id": 1000218
      },
      "writtenOn": "2019-10-28T04:13:55Z",
      "side": 1,
      "message": "What are we going to do with this incremented \"successes\" value? I think the MDS value in OLT(onu-adapter here) will be incremented in response of SET MDS.",
      "range": {
        "startLine": 155,
        "startChar": 16,
        "endLine": 155,
        "endChar": 25
      },
      "revId": "9c0e958d16e392701542cdc5e1ba023dbd9c6d8b",
